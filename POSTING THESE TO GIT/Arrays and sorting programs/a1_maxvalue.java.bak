import java.util.Scanner;
class  a1_maxvalue
{
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);

		int[] a={1,2,30,4,5};
		int max=a[0];
		for(int i=1;i<a.length;i++){
			
			if(max<a[i]){
				max=a[i]
			}
		}
		
        System.out.println("\n Maximum value is---> " + max);
		
	}
}
