class a24_linearsearch
{
	
	public static void main(String[] args) 
	{
		int[] a={10,20,30,40};
		
		int key=20;
		
		boolean ispresent=false;
		
		for(int i=0;i<a.length;i++){
			
			if(a[i]==key){
				
				ispresent=true;
				
			}
		}
		
		if(ispresent){
			
			System.out.println("yes we have!!");
		}
		
		else{
			
			System.out.println("nope!!");
		}
		
	}
}
