class  num17_primenumber
{
	public static int prime(int n){
		int c=0;
		
		while(n!=0){
			n=n/10;
			c++;
		}
		for(int i=1;i<=n;i++){
			if(n%i==0){
				c++;
			}
		}
		if(c==2)
		{
			return 1;
		}
		else{
			return 0;
     	}
		
		
		}
	public static void main(String[] args) 
	{
		int num=7;
		int res=prime(num);
		if(res==1){
		System.out.println("prime");}
		else{System.out.println("Not prime");}
	}
}
