class num37_abundantnumber 
{
	public static void abudant(int n){
		int sum=0;
		
		
		for(int i=1;i<n;i++){
			if(n%i==0){
				sum=sum+1;
			}
		}
		if(sum>n){
			System.out.println("Abudant num");
		}
		else{
			System.out.println("not Abudant num");
		}
	}
	public static void main(String[] args) 
	{
		int n=12;
		abudant(n);
	}
}
