class num15_secondlargestdigit 
{
	public static int secondlargestdigit (int n){
		int max=-1;
		int second=-1;
		
		while(n!=0){
			int last=n%10;
			
			if(last>max){
				second=max;
				max=last;
			}
			else if (last>second && last!=max)
			{
				second=last;
			}
			n=n/10;
		}
		return second;
	}
	public static void main(String[] args) 
	{
		int num=153;
		int res=secondlargestdigit(num);
		if(res==-1){
					System.out.println("no largest value");
		}
		System.out.println("second largest of digit --> "+res);
	}
}
