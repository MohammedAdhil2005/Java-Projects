import java.util.Scanner;
class  p22_leftanglesamerownumbertriangle
{
	public static void p22(int n){
		int num=1;
		int space=n-1;
		
		for(int i=1;i<=n;i++){
			
			for(int j=1;j<=num;j++){
				System.out.print(" "+j);
			}
			
			for(int k=1;k<=space;k++){
				System.out.print("  ");
			}
			
			System.out.println();
			num++;
			space--;
		}
	}
	
	public static void main(String[] args) 
	{
		Scanner scan=new Scanner(System.in);
		System.out.print("\n Enter the how many rows of left angle decrease triangle  ---->   ");
		int num=scan.nextInt();;
		System.out.println();
		p22(num);	
	}
}
