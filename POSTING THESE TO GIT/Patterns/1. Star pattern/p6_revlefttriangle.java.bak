import java.util.Scanner;
class  p6_revlefttriangle
{
	public static void p6(int n){
		int star=n;
		int space=0;
		
		
			
		for(int i=1;i<=n;i++){
			
			for(int k=1;k<=space;k++){
				System.out.print(" ");
			}
			
			for(int j=1;j<=star;j++){
				System.out.print("*");
			}
			
			System.out.println();
			
			
			
			space++;
			star--;
			
	    }}
	public static void main(String[] args) 
	{
		Scanner scan=new Scanner(System.in);
		System.out.print("\n Enter the how many rows of rev left angle star triangle  ---->   ");
		int num=scan.nextInt();;
		System.out.println();
		p6(num);
	}
}
