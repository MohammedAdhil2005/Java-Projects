class  p39_revalphabettriangle
{
	public static void main(String[] args) 
	{
		int n=5;
		int star=1;
		int space=n-1;
		
		char ch='A';
		
		for(int i=1;i<=n;i++){
			char temp=ch;
			for(int k=1;k<=space;k++){
				System.out.print(" ");
			}
			
			for(int j=1;j<=star;j++){
				System.out.print(temp-- +"");
			}
			System.out.println();
			ch+=1;
			star+=2;
			
			space--;
		}
		
	}
}
