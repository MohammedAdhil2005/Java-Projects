class string_26 
{
	public static void main(String[] args) 
	{
		// Question: Count the number of words in a sentence.
		
		String s="Java is a powerful language";
		int count=0;
		
		for(int i=0;i<s.length();i++){
			
			char ch=s.charAt(i);
			
			if(ch!=' ' && (i==0 || ch-1 ==' ')){
				count++;
			}
		}
		System.out.println("Words count are --> "+count);
	}
}
