class string_24 
{
	public static void main(String[] args) 
	{
		// Question: Count the number of space characters in a string
		
		String s="the sky is blue";
		int count=0;
		
		for(int i=0;i<s.length();i++){
			char ch=s.charAt(i);
			
			if(ch==" "){
				count++;
			}
		}
		System.out.println("Spaces count are --> "+count);
	}
}
