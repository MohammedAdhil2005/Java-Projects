class  string_21
{
	public static void main(String[] args) 
	{
		// Question: Count the number of digit characters in a string.
		
        String s="a1b2c3d4";
		int count=0;
		
		for(int i=0;i<s.length();i++){
			char ch=s.charAt(i);
			
			if(ch>='0' && ch<='9'){
				count++
			}
		}
		System.out.println("Digit counts are --> "+count);
	}
}
