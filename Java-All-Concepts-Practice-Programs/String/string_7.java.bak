class string_7 
{
	public static void main(String[] args) 
	{
		
		//Question: Find First Occurrence of a Character
		
		String s="programming";
		char target='g';
		
		System.out.println("\nFirst Occurence using predefined method --> "+s.indexOf(target)+"\n");
				
		for(int i=0;i<s.length();i++){
			
			char ch=s.charAt(i);
			
			if(ch==target){
				System.out.println("First Occurence using Manual method --> "+i);
				break;
			}
		}
	}
}
