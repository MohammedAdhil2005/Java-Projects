class  a18_thirdlargestelement
{
	public static void main(String[] args) 
	{
		int[] a = {40,30,35,20};
		
		int fmax=Integer.MIN_VALUE;
		int smax=Integer.MIN_VALUE;
		int tmax=Integer.MIN_VALUE;
		
		for(int i=0;i<a.length;i++){
			if(fmax<a[i]){
				tmax=smax;
				smax=fmax;
				fmax=a[i];
			}
			
		}
		System.out.println(tmax);
	}
}
