	//------------------------FIFTEEN---------------------------
	
	
	public static void findarraylength(int[] a){
		
		System.out.println("\nThe length of the given array is ----> "+(a.length-1));
		System.out.println("\n------------------------- ");
		
	}
	
	
	//-----------------------SIXTEEN----------------------------
	
	
	public static void secondmax(int[] a){
		int firstmax=Integer.MIN_VALUE;
		int secondmax=Integer.MIN_VALUE;
		
		for(int i=0;i<a.length;i++){
			if(firstmax<a[i]){
				secondmax=firstmax;
				firstmax=a[i];
			}
			else if(secondmax<a[i] && a[i]!=firstmax){
				secondmax=a[i];
			}
		}
		
		System.out.println("\nSecond max of the given array is ---> "+secondmax);
		System.out.println("\n------------------------- ");
		
	}
	
	
	//-----------------------SEVENTEEN----------------------------
	
	
	public static void secondmin(int[] a){
		int firstmin=Integer.MAX_VALUE;
		int secondmin=Integer.MAX_VALUE;
		
		for(int i=0;i<a.length;i++){
			if(firstmin>a[i]){
				secondmin=firstmin;
				firstmin=a[i];
			}
			else if(secondmin>a[i] && a[i]!=firstmin){
				secondmin=a[i];
			}
		}
		
		System.out.println("\nSecond min of the given array is ---> "+secondmin);
		System.out.println("\n------------------------- ");
	}
	
	
	//----------------------EIGHTTEEN-----------------------------
	
	
	public static void thirdmax(int[] a){
		int firstmax=Integer.MIN_VALUE;
		int secondmax=Integer.MIN_VALUE;
		int thirdmax=Integer.MIN_VALUE;
		
		for(int i=0;i<a.length;i++){
			if(firstmax<a[i]){
				thirdmax=secondmax;
				secondmax=firstmax;
				firstmax=a[i];
			}
			
			else if(secondmax<a[i] && a[i]!=firstmax){
				thirdmax=secondmax;
				secondmax=a[i];
			}
			
			else if(thirdmax<a[i] && a[i]!=secondmax && a[i]!=firstmax){
				thirdmax=a[i];
			}
		}
		
		System.out.println("\nThird max of the given array is ---> "+thirdmax);
		System.out.println("\n------------------------- ");
		
	}
	
	
	//----------------------NINETEEN-----------------------------
	
	
	public static void thirdmin(int[] a){
		int firstmin=Integer.MAX_VALUE;
		int secondmin=Integer.MAX_VALUE;
		int thirdmin=Integer.MAX_VALUE;
		
		for(int i=0;i<a.length;i++){
			if(firstmin>a[i]){
				thirdmin=secondmin;
				secondmin=firstmin;
				firstmin=a[i];
			}
			
			else if(secondmin>a[i] && a[i]!=firstmin){
				thirdmin=secondmin;
				secondmin=a[i];
			}
			
			else if(thirdmin>a[i] && a[i]!=firstmin && a[i]!=secondmin){
				thirdmin=a[i];
			}
		}
		
		System.out.println("\nThird min of the given array is ---> "+thirdmin);
		System.out.println("\n------------------------- ");
	}
	
	
	//----------------------TWENTY-----------------------------
	
	
	public static void swap(int[] a){
		int[] aclone=a.clone();
		
		int temp=aclone[0];
		aclone[0]=aclone[a.length-1];
		aclone[a.length-1]=temp;
		
		System.out.println("\nSwapped array is ---> "+Arrays.toString(aclone));
		System.out.println("\n------------------------- ");
		
		
	}
	
	
	//----------------------TWENTYONE-----------------------------
	
	
	public static void linearsearch(int[] a){
		
		int target=10;
		boolean ispresent=false;
		
		System.out.println("\nLinear search --->  ");
		for(int i=0;i<a.length;i++){
			if(a[i]==target){
				ispresent=true;
			}
		}
		
		if(ispresent){
			System.out.println("\nYes we have this number ---> "+target);
		}
		else{
			System.out.println("\nNope didn't have this number ---> "+target);
		}
		
		System.out.println("\n------------------------- ");
		
	}
	
	
	//----------------------TWENTYTWO-----------------------------
	
	
	public static void binarysearch(int[] a){
		
		int[] sorted=a.clone();
		Arrays.sort(sorted);
		
		int target=10;
		int left=0;
		int right=a.length-1;
		
		boolean ispresent=false;
		
		System.out.println("\nBinary search --->  ");
		for(int i=0;i<a.length;i++){
			int mid=(left+right)/2;
			
			if(a[mid]==target){
				ispresent=true;
				break;
			}
			else if(a[mid]<target){
				left=mid+1;
			}
			else{
				right=mid-1;
			}
		}
		
		if(ispresent){
			System.out.println("\nYes we have this number ---> "+target);
		}
		else{
			System.out.println("\nNope didn't have this number ---> "+target);
		}
		
		System.out.println("\n------------------------- ");
		
	}
	
	
	//----------------------TWENTYTHREE-----------------------------
	
	
	public static void multipleoccurence(int[] a){
		boolean[] visit=new boolean[a.length];
		
		System.out.println("\nMultiple occurences --->  \n");
		for(int i=0;i<a.length;i++){
			
			if(visit[i]){
				continue;
			}
			
			int count=1;
			
			for(int j=i+1;j<a.length;j++){
				
				if(a[i]==a[j]){
					visit[j]=true;
					count++;
				}
			}
			
			if(count>1){
				System.out.println(a[i]+" repeated "+count+" times !!!");
			}
		}
		
		System.out.println("\n------------------------- ");
		
	}
	
	
	//----------------------TWENTYFOUR-----------------------------
	
	
	public static void countoccurences(int[] a){
		boolean[] visit=new boolean[a.length];
		
		System.out.println("\nCount occurences of ---> \n");
		
		for(int i=0;i<a.length;i++){
			
			if(visit[i]){
				continue;
			}
			
			int count=1;
			
			for(int j=i+1;j<a.length;j++){
				
				if(a[i]==a[j]){
					visit[j]=true;
					count++;
				}
			}
			
			System.out.println(a[i]+" repeated "+count+" times !!!");
		}
		
		System.out.println("\n------------------------- ");
		
	}
	
	
	//-----------------------TWENTYFIVE----------------------------
	
	
	public static void firstoccurence(int[] a){
		boolean[] visit=new boolean[a.length];
		
		System.out.println("\nFirst occurence --->  \n");
		
		for(int i=0;i<a.length;i++){
			if(visit[i]){
				continue;
			}
			
			
			System.out.println(a[i]+" occured "+i+" position !!!");
			
			for(int j=i+1;j<a.length;j++){
				if(a[i]==a[j]){
					visit[j]=true;
				}
			}			
		}
		
		System.out.println("\n------------------------- ");
		
	}
	
	
	//----------------------TWENTYSIX-----------------------------
	
	
	public static void lastoccurence(int[] a){
		boolean[] visit=new boolean[a.length];
		
		System.out.println("Last occurence --->  \n");
		for(int i=0;i<a.length;i++){
			if(visit[i]){
				continue;
			}
			
			int lastindex=i;
			
			for(int j=i+1;j<a.length;j++){
				if(a[i]==a[j]){
					lastindex=j;
					visit[j]=true;
				}
			}
			
			System.out.println(a[i]+" repeated "+lastindex+" position !!!");
		}
		
		System.out.println("\n------------------------- ");
	}
	
	
	//-----------------------TWENTYSEVEN----------------------------
	
	
	public static void  checkelementexist(int[] a){
		int target=7;
		boolean ispresent=false;
		
