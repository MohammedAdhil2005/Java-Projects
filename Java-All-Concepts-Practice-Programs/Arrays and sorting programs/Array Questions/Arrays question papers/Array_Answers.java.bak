	}
	
	
	//-----------------------TWENTYEIGHT----------------------------
	
	
	public static void missingnumber(){
		int[] a={1,2,3,5};
		
		int n=5;
		boolean[] visit =new boolean[n+1];
		
		System.out.print("\nMissing number are ---> ");
		
		for(int num:a){
			visit[num]=true;
		}
		
		for(int i=1;i<n;i++){
			if(!visit[i]){
				System.out.print(i+" ");
			}
		}
		
		System.out.println("\n\n------------------------- ");
		
	}
	
	
	//----------------------TWENTYNINE-----------------------------
	
	
	public static void missingnumbers(int[] a){
		int n=10;
		boolean[] visit=new boolean[n+1];
		
		System.out.print("\nMissing numbers are ---> ");
		
		for(int num:a){
			visit[num]=true;
		}
		
		for(int i=1;i<n;i++){
			if(!visit[i]){
				System.out.print(i+" ");
			}
		}
		
		System.out.println("\n\n------------------------- ");
		
	}
	
	
	//----------------------THIRTY-----------------------------
	
	
	public static void findindex(int[] a){
		int target=7;
		
		System.out.println("\nFind Index !!  \n");
		for(int i=0;i<a.length;i++){
			if(target==a[i]){
				System.out.println(target+" present in index of --> "+i);
			}
		}
		
		System.out.println("\n------------------------- ");
		
	}
	
	
	
	//----------------------FIFTYONE-----------------------------
	
	
	public static void leftrotatebyone(int[] a){
		
		int[] a1=a.clone();
		
		int temp=a1[0];
		
		for(int i=0;i<a1.length-1;i++){				
				a1[i]=a1[i+1];
		}
		
		a1[a1.length-1]=temp;
		
		System.out.println("\nLeft rotate by one unit ---> "+Arrays.toString(a1));
		
		System.out.println("\n------------------------- ");
		
	}
	
	
	//----------------------FIFTYTWO-----------------------------
	
	
	public static void rightrotatebyone(int[] a){
		
		int[] a2=a.clone();
		
		int temp=a2[a2.length-1];
		
		for(int i=a2.length-1;i>0;i--){				
				a2[i]=a2[i-1];
		}
		
		a2[0]=temp;
		
		System.out.println("\nRight rotate by one unit ---> "+Arrays.toString(a2));
		
		System.out.println("\n------------------------- ");
		
	}
	
		
		
	//----------------------FIFTYTHREE-----------------------------
	
	
	public static void leftrotatebyktimes(int[] a){
		
		int[] a3=a.clone();
		
		int ktimes=1;
		int temp=a3[0];
		
		for(int k=1;k<=ktimes;k++){
			
		for(int i=0;i<a3.length-1;i++){				
				a3[i]=a3[i+1];
		}
		
		}
		
		a3[a3.length-1]=temp;
		
		System.out.println("\nLeft rotate by k times ---> "+Arrays.toString(a3));
		
		System.out.println("\n------------------------- ");
		
	}
	
	
	//----------------------FIFTYFOUR-----------------------------
	
	
	public static void rightrotatebyktimes(int[] a){
		int[] a4=a.clone();
		
		int ktimes=1;
		
		int temp=a4[a4.length-1];
		
		for(int k=1;k<=ktimes;k++){
			
			for(int i=a4.length-1;i>0;i--){
				
				a4[i]=a4[i-1];
				
			}
		}
		
		a4[0]=temp;
		
		System.out.println("\nRight rotate by k times ---> "+Arrays.toString(a4));
		
		System.out.println("\n------------------------- ");
		
	}
	
	
	//----------------------FIFTYFIVE-----------------------------
	
	
	public static void reverseafterrotation(int[] a){
		
		int temp=a[0];
		
		for(int i=0;i<a.length-1;i++){
			a[i]=a[i+1];
		}
		
		a[a.length-1]=temp;
		
		System.out.println("\nLeft rotaion by 1 unit --> "+Arrays.toString(a));
		
		int[] rev=new int[a.length];
		
		int last=a[a.length-1];
		
		for(int i=0;i<a.length;i++){
			rev[last]=a[i];
			last--;
		}
		
		System.out.println("\nReversed left rotation by 1 unit --> "+Arrays.toString(rev));
		
		System.out.println("\n------------------------- ");
		
	}
	
	
	//----------------------FIFTYSEVEN-----------------------------
	
	
	public static void clockwiserotate(int[] a){
		
		
		int temp=a[a.length-1];
		
		for(int i=a.length-1;i>0;i--){				
				a[i]=a[i-1];
		}
		
		a[0]=temp;
		
		System.out.println("\nClock wise rotate by one unit ---> "+Arrays.toString(a));
		
		System.out.println("\n------------------------- ");
		
	}
	
	
	//----------------------FIFTYEIGHT-----------------------------
	
	
	public static void anticlockwiserotate(int[] a){
		
		int temp=a[0];
		
		for(int i=0;i<a.length-1;i++){				
				a[i]=a[i+1];
		}
		
		a[a.length-1]=temp;
		
		System.out.println("\nAnti clock wise rotate by one unit ---> "+Arrays.toString(a));
		
		System.out.println("\n------------------------- \n");
		
	}
	
	
	//----------------------FIFTYNINE-----------------------------
	
	
	public static void splitarray(int[] a){
		
		int half=a.length/2;
		
		for(int i=0;i<half;i++){
			System.out.print(a[i]+" ");
		}
		
		System.out.print("||SPILLED|| ");
		
		for(int i=half;i<a.length;i++){
			System.out.print(a[i]+" ");
		}
		
		System.out.println("\n\n------------------------- \n");
		
	}
	
	
	//----------------------SIXTY-----------------------------
	
	
	public static void mergearray(){
		
		int[] a={10,20};
		int[] b={30,40};
		
		System.out.println("Array 1 ---> "+Arrays.toString(a));
		System.out.println("Array 2 ---> "+Arrays.toString(b));
		
		System.out.print("\n MERGED ---> ");
		
		int[] res=new int[a.length+b.length];
		
		int index=0;
		
		for(int i=0;i<a.length;i++){
			res[index++]=a[i];
		}
		
		
		
		for(int j=0;j<b.length;j++){
			res[index++]=b[j];
		}
		
		System.out.println(Arrays.toString(res));
		
		System.out.println("\n------------------------- ");
	}
	
	
	
	//----------------------MAIN METHOD-----------------------------
	
	
	public static void main(String[] args) 
	{
		int[] a={7,3,1,1,4,10,7,8};
		
		// ------- 1 to 11 -------
		printread(a);
		sum(a);
		avg(a);
		max(a);
		min(a);
		counteven(a);
		countodd(a);
		countpositivenum(a);
		countnegativenum(a);
		revarray(a);
		copyarray(a);
		
		// ------- 12 to 20 -------
		printalternate(a);
		printfirsthalf(a);
		printsecondhalf(a);
		findarraylength(a);
		secondmax(a);
		secondmin(a);
		thirdmax(a);
		thirdmin(a);
		swap(a);
		
		// ------- 21 to 30 -------
		linearsearch(a);
		binarysearch(a);
		multipleoccurence(a);
		countoccurences(a);
		firstoccurence(a);
		lastoccurence(a);
		checkelementexist(a);
		missingnumber();
		missingnumbers(a);
		findindex(a);
		
		// ------- 51 to 60 -------
		leftrotatebyone(a);
		rightrotatebyone(a);
		leftrotatebyktimes(a);
		rightrotatebyktimes(a);
		
		reverseafterrotation(a.clone());
		clockwiserotate(a.clone());
		anticlockwiserotate(a.clone());
		splitarray(a.clone());
		mergearray();
		
	}
}
