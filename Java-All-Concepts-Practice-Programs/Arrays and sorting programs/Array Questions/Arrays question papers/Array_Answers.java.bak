		System.out.print("\nThe alternate Elements of the given array is --->  ");
		for(int i=0;i<a.length;i+=2){
			System.out.print(a[i]+" ");
		}
		
		System.out.println("\n\n------------------------- ");
	}
	
	
	//------------------------THIRTEEN---------------------------
		
	
