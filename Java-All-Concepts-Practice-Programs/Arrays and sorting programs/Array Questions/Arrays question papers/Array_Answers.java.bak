	}
	
	
	//-------------------------FOURTEEN--------------------------
	
	
	public static void printsecondhalf(int[] a){
		
		System.out.print("\nThe second half of the given array is --->  ");
		
		for(int i=a.length/2;i<a.length;i++){
			System.out.print(a[i]+" ");
