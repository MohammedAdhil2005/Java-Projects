import java.util.Arrays;
class Array_Answers 
{
	//----------------------ONE-----------------------------
	
	public static void printread(int[] a){
		System.out.print("\n\nThe given array is --->  ");
		
		for(int i=0;i<a.length;i++){
			System.out.print(a[i]+" ");
		}
		
		System.out.println("\n\n------------------------- ");
	}
	
	
	//-----------------------TWO----------------------------
	
	
	public static void sum(int[] a){
		
		int sum=0;
		
		for(int i=0;i<a.length;i++){
			sum=sum+a[i];
		}
		
		System.out.println("\nSum of the given array is ---> "+sum);
		System.out.println("\n------------------------- ");
	}
	
	
	//---------------------THREE------------------------------
	
	
	public static void avg(int[] a){
		
		int sum=0;
		
		for(int i=0;i<a.length;i++){
			sum=sum+a[i];
		}
		
		int avg=sum/a.length;
		
		System.out.println("\nAvg of the given array is ---> "+avg);
		System.out.println("\n------------------------- ");
		
	}
	
	
	//---------------------FOUR------------------------------
		
	
	public static void max(int[] a){
		
		int max=Integer.MIN_VALUE;
		
		for(int i=0;i<a.length;i++){
			if(max<a[i]){
				max=a[i];
			}
		}
		
		System.out.println("\nMax of the given array is ---> "+max);
		System.out.println("\n------------------------- ");
		
	}
	
	
	//---------------------FIVE------------------------------
	
	
	public static void min(int[] a){
		
		int min=Integer.MAX_VALUE;
		
		for(int i=0;i<a.length;i++){
			if(min>a[i]){
				min=a[i];
			}
		}
		
		System.out.println("\nMin of the given array is ---> "+min);
		System.out.println("\n------------------------- ");
		
	}
	
	
	//-----------------------SIX----------------------------
		
	
	public static void counteven(int[] a){
		
		int count=0;
		
		for(int i=0;i<a.length;i++){
			if(a[i]%2==0){
				count++;
			}
		}
		
		System.out.println("\nCount Even number in the given array is ---> "+count);
		System.out.println("\n------------------------- ");
		
	}
	
	
	//-----------------------SEVEN----------------------------
		
	
	public static void countodd(int[] a){
		
		int count=0;
		
		for(int i=0;i<a.length;i++){
			if(a[i]%2!=0){
				count++;
			}
		}
		
		System.out.println("\nCount Odd number in the given array is ---> "+count);
		System.out.println("\n------------------------- ");
		
	}
	
	
	//----------------------EIGHT-----------------------------
		
	
	public static void countpositivenum(int[] a){
		
		int count=0;
		
		for(int i=0;i<a.length;i++){
			if(a[i]>0){
				count++;
			}
		}
		
		System.out.println("\nCount positive number in the given array is ---> "+count);
		System.out.println("\n------------------------- ");
		
	}
	
	
	//-----------------------NINE----------------------------
		
	
	public static void countnegativenum(int[] a){
		
		int count=0;
		
		for(int i=0;i<a.length;i++){
			if(a[i]<0){
				count++;
			}
		}
		
		System.out.println("\nCount negative number in the given array is ---> "+count);
		System.out.println("\n------------------------- ");
		
	}
	
	
	//------------------------TEN---------------------------
		
	
	public static void revarray(int[] a){
		
		int[] rev =new int[a.length];
		int last=a.length-1;
		
		for(int i=0;i<a.length;i++){
			rev[last]=a[i];
			last--;
		}
		
        System.out.println("\nReverse the given array is ---> "+Arrays.toString(rev));
		System.out.println("\n------------------------- ");
		
	}
	
	
	//-----------------------ELEVEN----------------------------
		
	
	public static void copyarray(int[] a){
		
		int[] copy=new int[a.length];
		
		for(int i=0;i<a.length;i++){
			copy[i]=a[i];
		}
		
        System.out.println("\nCopy this given array to another array is ---> "+Arrays.toString(copy));
		System.out.println("\n------------------------- ");
		
	}
	
	
	//------------------------TWELVE---------------------------
		
	
