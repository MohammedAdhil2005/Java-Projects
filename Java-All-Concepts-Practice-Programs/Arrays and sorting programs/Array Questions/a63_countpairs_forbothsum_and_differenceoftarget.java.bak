class a63_countpairs_forbothsum_and_differenceoftarget
{
	public static void countsumpairs(int[] a){
		int target=9;
		int count=0;
		
		boolean ispresent=false;
		
		for(int i=0;i<a.length;i++){
			
			for(int j=i+1;j<a.length;j++){
				
				if(a[i]+a[j]==target){
					count++;
					System.out.println(a[i]+" + "+a[j]+" sum of ---> "+target);
					ispresent=true;
				}
			}
		}
		
				
		if(!ispresent){
			System.out.println("\nNo matching pairs!!!!");
		}
		
		System.out.println("the sum of count pairs is ---> "+count);
		
		System.out.println("\n------------------------------------ \n");
	}
	
	
	
	public static void countdifferencepairs(int[] a){
		int target=9;
		int count=0;
		
		boolean ispresent=false;
		
		for(int i=0;i<a.length;i++){
			for(int j=i+1;j<a.length;j++){
				int temp =a[i]-a[j];
				
				if(temp<0){
					temp=temp*-1;
				}
				
				if(temp==target){
					count++;
					System.out.println(a[i]+" - "+a[j]+" difference of ---> "+target);
					ispresent=true;
				}
			}
		}
		
		if(!ispresent){
			System.out.println("\nNo matching pairs!!!!");
		}
		
		System.out.println("the difference of count pairs is ---> "+count);
		
	}
	public static void main(String[] args) 
	{
		int[] a = {2,7,11,15,5};
		countsumpairs(a);
		countdifferencepairs(a);
		
	}
}
