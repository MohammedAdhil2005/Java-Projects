class num49_fibonaccirange
{
	public static void fibo(int start,int end){
		int a=0;
		int b=1;
		
		while(a<=end){
			if(a>=start)//if we wnat even num using this {a%2==0}
		{
			System.out.println(a);}
			int c=a+b;
			a=b;
			b=c;
		}
	}
	public static void main(String[] args) 
	{
		int st=5;int end=20;
		fibo(st,end);
	}
}
