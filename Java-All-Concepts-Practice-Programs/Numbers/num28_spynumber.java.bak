class num28_spynumber 
{
	public static boolean spynumber(int n){
		int sum=0;
		int pro=1;
		
		while(n!=0){
			int last=n%10;
			sum=sum+last;
			pro=pro*last;
			n=n/10;
		}
		return pro==sum;
	}
	public static void main(String[] args) 
	{
		int num=123;
		boolean res=spynumber(num);
		if(res){System.out.println("YEPPP!");}
		else{System.out.println("nope");}
	}
}
