class car
{
	String name;
	int price;
	String color;
	
	tyre[] t=new tyre[4];
	int index=0;
	
	car(String name, int price ,String color){
		this.name=name;
		this.price=price;
		this.color=color;
	}
	
	public void gettyre(tyre t){
		this.t[index++]=t;
	}
	
}

class tyre
{
	String brand;
	int price;
	
	tyre(String brand,int price){
		this.brand=brand;
		this.price=price;
	}
}

class main2 
{
	public static void main(String[] args) 
	{
		car c=new car("BMW",5000,"Red");
		c.gettyre(new tyre("Mrf",100));
		c.gettyre(new tyre("appollo",100));
		c.gettyre(new tyre("jk",100));
		c.gettyre(new tyre("ceat",100));
		
		
		System.out.println(c.name +" "+c.color+" "+c.price+"\n");
		
		for(int i=0;i<c.t.length;i++){
			System.out.println(c.t[i].brand+" "+c.t[i].price);
		}
	}
}
