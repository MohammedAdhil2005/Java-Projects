import java.util.ArrayList;

class book
{
	int price;
	String bname;
	
	book(int price, String bname){
		this.price=price;
		this.bname=bname;
	}
	
	public String toString(){
		return price+" "+bname;
	}
}

class Mobile
{
	int Mprice;
	String Mname;
	
	Mobile(int Mprice, String Mname){
		this.Mprice=Mprice;
		this.Mname=Mname;
	}
	
	public String toString(){
		return Mprice+" "+Mname;
	}
}


class customobjIn_ArrayList
{
	public static void main(String[] args) 
	{
		
		ArrayList l1=new ArrayList();
		
		System.out.println(l1); //it will so nothing!!!
		
		l1.add(new book(100,"java"));
		l1.add(new book(1500,"python"));
		
		l1.add(new Mobile(1000,"Oneplus"));
		l1.add(new Mobile(15000,"Apple"));
		
		
		System.out.println(l1);
		
