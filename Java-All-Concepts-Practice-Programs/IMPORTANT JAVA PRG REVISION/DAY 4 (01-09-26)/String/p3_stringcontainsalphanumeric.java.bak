class  p3_stringcontainsalphanumeric
{
	public static void main(String[] args) 
	{
		String s="Adhil1223";
		boolean prs=true;
		
		for(int i=0;i<s.length();i++){
			char ch=s.charAt(i);
			
			if(!((ch>='a' && ch<='z') || (ch>='A' && ch<='Z') || (ch>='0' && ch<='9'))){
				prs=false;
				break;
			}
		}
		if(prs){
			System.out.println("yeppp it containsss");
		}
		else{
			System.out.println("Nopeee");
		}
	}
}
