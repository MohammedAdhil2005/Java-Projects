class p1_largeandsmallinarray
{
	public static void main(String[] args) 
	{
		int[] a={10, 25, 5, 40, 15};
		int big=0;
		int small=0;
		
		for(int i=0;i<a.length;i++){
			for(int j=1;j<a.length;j++){
				if(a[i]>a[j]){
					small=a[j];
				}
				else if(a[i]<a[j]){
					big=a[j];
				}
			}
		}
		
		System.out.println("Large element is --> "+big);
		System.out.println("Smallest element is --> "+small);
	}
}
