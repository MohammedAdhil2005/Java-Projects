class p3_duplicateElements
{
	public static void main(String[] args) 
	{
		int[] a={1,2,3,4,2};
		int count=1;
		int dup=0;
		
		for(int i=0;i<a.length;i++){
			for(int j=1;j<a.length;j++){
				if(a[i]==a[j]){
				  count++;
				}
				else if(count>1){
			      dup=a[i];
				}	
			}
		}
		
		System.out.println(dup);
		
		
	}
}
