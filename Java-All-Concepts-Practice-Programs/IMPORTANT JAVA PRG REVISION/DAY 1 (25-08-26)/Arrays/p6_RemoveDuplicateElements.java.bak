import java.util.Arrays;
class p6_RemoveDuplicateElements 
{
	public static void main(String[] args) 
	{
		int[] a={1,2,3,4,2};
		int dup=0;
		
		
		for(int i=0;i<a.length;i++){
			for(int j=i+1;j<a.length;j++){
				if(a[i]==a[j]){
					a[j] = 0;
				}
			}
		}
		
		for(int i=0;i<a.length;i++){
			if(a[i]!=0){
				System.out.print(a[i]+" ");
			}
		}
		
	}
}
