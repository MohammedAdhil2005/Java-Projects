import java.util.Scanner;
class p21_rightanglesamerownumbertriangle 
{
	public static void p21(int n){
		int num=1;
		
		for(int i=1;i<=n;i++) {
			for(int j=1;j<=num;j++){
				System.out.print(i);
			}
			System.out.println();
			num++;
		}
	}
	public static void main(String[] args) 
	{
		Scanner scan=new Scanner(System.in);
		System.out.print("\n Enter the how many rows of right angle same triangle  ---->   ");
		int num=scan.nextInt();;
		System.out.println();
		p21(num);
			
	}
}
